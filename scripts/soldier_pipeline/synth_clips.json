      "source": { "action": "Kneel.Idle", "from": "start", "to": "start" },
      "ops": [
        {
          "op": "hold",
          "frames": 10,
          "at": "start",
          "breathe": { "bones": { "mixamorig:Spine1": [1.4, 0, 0] }, "period": 10 }
        },
        {
          "op": "offset",
          "space": "local",
          "bones": {
            "mixamorig:Spine": [6, 0, -3],
            "mixamorig:Spine1": [4, 0, -2],
            "mixamorig:Spine2": [2, 0, 0],
            "mixamorig:Neck": [5, 0, 0],
            "mixamorig:Head": [3, 0, 0]
          }
        }
      ]
    },
    {
      "_note": "遮蔽から身を乗り出して射撃。前傾+右肩側ロールで射線側へ出る。ランタイムの COVER_LEAN_PX 2.5px と同方向に効かせる。",
      "name": "Kneel.Cover_Fire",
